    "definitions": {
        "api.CreateAPIKeyRequestParams": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "networks": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "aura",
                            " solana"
                        ]
                    }
                }
            }
        },
        "api.UpdateAPIKeyRequestParams": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "x-nullable": true
                },
                "networks": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "aura",
                            " solana"
                        ]
                    }
                }
            }
        },
        "api.User": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "dynamic_id": {
                    "type": "string"
                },
                "mplx_balance": {
                    "type": "integer"
                },
                "subscription": {
                    "$ref": "#/definitions/postgres.Subscription"
                }
            }
        },
        "postgres.APIKeyWithSupportedNetworks": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "deleted_at": {
                    "type": "string"
                },
                "last_used": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "supported_networks": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "token": {
                    "type": "string"
                },
                "total_requests": {
                    "type": "integer"
                }
            }
        },
        "postgres.Subscription": {
            "type": "object",
            "properties": {
                "minimum_balance": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "requests_per_second": {
                    "type": "integer"
                },
                "token_limit": {
                    "type": "integer"
                }
            }
        }
    },
    "securityDefinitions": {
        "ApiKeyAuth": {
            "description": "Bearer JWT",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
